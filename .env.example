APP_URL=http://localhost:3000
PORT=3000
APP_KEY=

# Set POSTGRES_PASSWORD to the password of PGUSER on this server.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=email_scheduler
PGUSER=postgres
POSTGRES_PASSWORD=
PGSSLMODE=disable
# Alternative TLS switch for hosted PostgreSQL
PGSSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_TLS=false

# Choose the authentication method used by your search cluster.
ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_AUTH=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ethereal SMTP: smtp.ethereal.email, port 587, STARTTLS.
# Replace user and pass with credentials from your Ethereal account.
SMTP_SENDERS=[{"id":"primary","user":"your-mailbox@ethereal.email","pass":"your-ethereal-password"}]

QUEUE_ADMIN_EMAIL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=8
