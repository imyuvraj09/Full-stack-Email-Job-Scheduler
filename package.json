{
  "name": "email-job-scheduler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "api": "node --env-file-if-exists=.env --import tsx backend/src/api.ts",
    "worker": "node --env-file-if-exists=.env --import tsx backend/src/worker.ts",
    "start": "node --env-file-if-exists=.env --import tsx backend/src/api.ts",
    "web": "vite frontend --host 0.0.0.0",
    "build": "tsc --noEmit && vite build frontend",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --test tests/integration/scheduler.test.mjs"
  },
  "dependencies": {
    "@bull-board/api": "6.12.0",
    "@bull-board/express": "6.12.0",
    "bullmq": "5.81.6",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "nodemailer": "10.6.1",
    "pg": "8.16.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.33",
    "smtp-server": "^3.21.7",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  },
  "description": "Schedule email campaigns with per-sender rate limits and delivery tracking.",
  "engines": {
    "node": ">=22.13.0"
  }
}
